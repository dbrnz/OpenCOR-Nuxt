{
  "version": "0.20260809.0",
  "opencorVersion": "0.20260727.3",
  "libopencorVersion": "1.20260803.0",
  "author": {
    "name": "Alan Garny",
    "email": "a.garny@auckland.ac.nz"
  },
  "bugs": {
    "url": "https://github.com/opencor/webapp/issues"
  },
  "description": "A Web-based modelling environment for organising, editing, simulating, and analysing CellML files.",
  "files": [
    "dist",
    "README.md",
    "LICENSE.txt"
  ],
  "homepage": "https://opencor.ws/",
  "keywords": [
    "vue",
    "component",
    "opencor",
    "cellml",
    "sed-ml",
    "omex",
    "combine"
  ],
  "license": "Apache-2.0",
  "module": "dist/opencor.es.js",
  "name": "@opencor/opencor",
  "productName": "OpenCOR",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opencor/webapp.git"
  },
  "type": "module",
  "types": "dist/index.d.ts",
  "engines": {
    "bun": ">=1.2.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/opencor.es.js"
    },
    "./style.css": "./dist/opencor.css"
  },
  "scripts": {
    "build": "nuxt build",
    "clean": "bun scripts/generate.version.ts && bun scripts/clean.ts",
    "compile": "bun run --bun build && bun run scripts/build.executables.ts",
    "dependencies:update": "bun scripts/dependencies.update.ts",
    "dev": "nuxt dev",
    "format": "bunx --bun biome format --fix --max-diagnostics=none",
    "format:check": "bunx --bun biome format --max-diagnostics=none",
    "lint": "bunx --bun biome lint --fix --diagnostic-level=error --max-diagnostics=none && bunx stylelint '**/*.css' --fix",
    "prebuild": "bun scripts/generate.version.ts",
    "predev": "bun scripts/generate.version.ts",
    "start": "bun run build && nuxt preview",
    "typecheck": "bun --bun scripts/type.check.ts --noEmit",
    "version:new": "bun scripts/version.new.ts",
    "postinstall": "bun scripts/libopencor.install.ts"
  },
  "dependencies": {
    "@celldl/viewer": "^0.20260807.1",
    "@jeswr/pretty-turtle": "^1.8.2",
    "@napi-rs/keyring": "^1.3.0",
    "@opencor/libopencor-types": "^1.20260723.2",
    "@primeicons/vue": "^8.0.0",
    "@primeuix/themes": "2.0.3",
    "@primevue/auto-import-resolver": "^5.0.0",
    "@vueuse/core": "^14.3.0",
    "jszip": "^3.10.1",
    "nuxt": "^4.5.1",
    "nuxt-bun-compile": "0.1.32",
    "oxigraph": "^0.5.9",
    "primeicons": "7.0.0",
    "primevue": "4.2.5",
    "vue": "^3.5.40",
    "xxhash-wasm": "^1.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.1",
    "@types/plotly.js": "^3.0.10",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.5.4",
    "esbuild": "^0.28.1",
    "postcss": "^8.5.23",
    "rollup-plugin-visualizer": "^7.0.1",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-primeui": "0.6.1",
    "typescript": "^7.0.2",
    "typescript-6": "npm:typescript@^6.0.3",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.2.0",
    "vue-tsc": "^3.3.8"
  }
}
